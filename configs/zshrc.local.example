# 서버별 설정. install.sh 가 ~/.zshrc.local 로 복사해 주며, 이 파일은 git 추적 대상이 아님.
# 필요한 것만 주석을 해제해서 사용한다.

# ---- GPU ----
# 사용할 GPU 번호는 여기 한 곳만 수정 (공유 서버에서는 할당된 GPU 만).
# CUDA 와 headless 렌더링(EGL)이 같은 GPU 를 쓰도록 함께 설정된다.
# GPU_ID=0
# export CUDA_VISIBLE_DEVICES=$GPU_ID
# export EGL_DEVICE_ID=$GPU_ID

# ---- CUDA toolkit (시스템 CUDA 를 쓸 때만; pixi 로 nvcc 를 받으면 불필요) ----
# export CUDA_HOME=/usr/local/cuda-12.4
# export PATH=$CUDA_HOME/bin:$PATH
# export LD_LIBRARY_PATH=$CUDA_HOME/lib64:${LD_LIBRARY_PATH}

# ---- CUDA extension 빌드 (flash-attn, cpp_extension 등) ----
# export TORCH_CUDA_ARCH_LIST="8.0"   # GPU compute capability (A100=8.0, RTX3090=8.6, RTX4090=8.9, H100=9.0)
# export MAX_JOBS=8                   # 병렬 빌드 수 (메모리가 부족하면 낮출 것)

# ---- 캐시 / 임시 디렉토리 (홈 용량이 작거나 NFS 일 때 큰 디스크로 이동) ----
# export PIXI_CACHE_DIR=/mnt/ssd/$USER/cache/pixi
# export UV_CACHE_DIR=/mnt/ssd/$USER/cache/uv
# export HF_HOME=/mnt/ssd/$USER/cache/huggingface
# export TORCH_HOME=/mnt/ssd/$USER/cache/torch
# export TRITON_CACHE_DIR=/mnt/ssd/$USER/cache/triton
# export TMPDIR=/mnt/ssd/$USER/tmp

# ---- 실험 도구 ----
# export WANDB_DIR=/mnt/ssd/$USER/wandb
# export WANDB_MODE=offline           # 인터넷이 없는 서버에서
# export HF_HUB_ENABLE_HF_TRANSFER=1  # huggingface 다운로드 가속 (hf_transfer 설치 필요)
# export HF_HUB_OFFLINE=1             # 인터넷이 없는 서버에서

# ---- 기타 ----
# export EDITOR=vim
